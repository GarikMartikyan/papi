# Имя панели. Уходит в <title> index.html и во вторую строку шаблонного
# логотипа (`LogoTemplate` из @papi/components). Читает его ядро — lib/services/env.service.ts.
VITE_APP_NAME=Example Panel

# Буквы в шаблонном логотипе: две-четыре, как RMP или MMP.
# Необязательна — без неё берутся первые буквы слов из VITE_APP_NAME.
VITE_APP_ABBR=EP

# Префикс, который приписывается ко всем путям эндпоинтов.
# Читает его ядро — lib/services/env.service.ts. Панель адрес никуда не передаёт.
# Годится и абсолютный адрес, если бэкенд на другом origin:
# VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=/api/v1
