# Имя панели. Уходит в <title> index.html и во вторую строку шаблонного
# логотипа (`LogoTemplate` из @papi/components). Читает его ядро — lib/services/env.service.ts.
VITE_APP_NAME=Example Panel

# Буквы в шаблонном логотипе: две-четыре, как RMP или MMP.
# Необязательна — без неё берутся первые буквы слов из VITE_APP_NAME.
# Ими же панель находит свою запись в каталоге логотипов ядра (`PanelLogo`).
VITE_APP_ABBR=EP

# Ключ панели у бэкенда — им она представляется на входе (`panelKey`).
# Необязательна — без неё берётся VITE_APP_ABBR строчными.
# Это не подпись, а ключ записи панели в papi-authority: неверный отвечает тем же
# «неверные данные», что и неправильный пароль.
VITE_PANEL_KEY=ep

# Префикс, который приписывается ко всем путям эндпоинтов.
# Читает его ядро — lib/services/env.service.ts. Панель адрес никуда не передаёт.
# Версии в пути у papi-authority нет. Годится и абсолютный адрес, если бэкенд на
# другом origin:
# VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_BASE_URL=/api

# Куда dev-сервер проксирует /api, пока панель и бэкенд подняты порознь.
# Только для разработки — в сборку не попадает, на проде адрес даёт сам ingress.
# Не задана — прокси нет, и относительный адрес остаётся на dev-сервере.
VITE_DEV_API_PROXY=http://localhost:7780
