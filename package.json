{
  "name": "papi",
  "version": "0.0.0",
  "private": true,
  "description": "Базовый проект админ-панелей: ядро в lib/, панель в src/.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "//": "TODO: заглушка — `start` поднимает мок бэкенда из tmp/, а её нет в git. Появится настоящий: адрес в .env, здесь остаётся `vite --host --open`, tmp/ удаляется.",
    "start": "vite --config tmp/vite.config.mock.ts --host --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": "^6.5.2",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.18",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
